<script>
  // Toggle class on html tag when mobile drawer opens/closes
  document.addEventListener('DOMContentLoaded', function () {
    const drawerDetails = document.getElementById('Details-menu-drawer-container');
    if (drawerDetails) {
      drawerDetails.addEventListener('toggle', function () {
        if (this.open) {
          document.documentElement.classList.add('is-mobile-drawer--open');
        } else {
          document.documentElement.classList.remove('is-mobile-drawer--open');
        }
      });
    }
  });
</script>

