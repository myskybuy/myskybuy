  <script>
    (() => {
      const strip = document.currentScript.previousElementSibling;
      const closeButton = strip?.querySelector('.welcome-strip__close');
      const slides = strip?.querySelectorAll('.welcome-strip__slide');

      if (slides && slides.length > 1) {
        let currentIndex = 0;
        setInterval(() => {
          slides[currentIndex].classList.remove('is-active');
          slides[currentIndex].classList.add('is-exit');
          
          const prevIndex = currentIndex;
          currentIndex = (currentIndex + 1) % slides.length;
          
          setTimeout(() => {
            slides[prevIndex].classList.remove('is-exit');
          }, 450);

          slides[currentIndex].classList.add('is-active');
        }, 3500);
      }

      const updateHeaderOffsets = () => {
        const header = document.querySelector('header-component');
        const headerGroup = document.querySelector('#header-group');
        const brandTopbar = document.querySelector('.brand-topbar');

        if (!header || !headerGroup) return;

        let headerGroupHeight = 0;
        Array.from(headerGroup.children).forEach((element) => {
          if (!(element instanceof HTMLElement) || element === header) return;
          headerGroupHeight += element.offsetHeight;
        });

        const headerHeight = header.offsetHeight;
        if (header.hasAttribute('transparent')) {
          headerGroupHeight += headerHeight;
        }

        document.body.style.setProperty('--header-height', `${headerHeight}px`);
        document.body.style.setProperty('--header-group-height', `${headerGroupHeight}px`);
        document.body.style.setProperty('--welcome-strip-height', '0px');
        if (brandTopbar instanceof HTMLElement) {
          document.body.style.setProperty('--brand-topbar-height', `${brandTopbar.offsetHeight}px`);
        }
      };

      closeButton?.addEventListener('click', () => {
        const section = strip.closest('.welcome-strip-section');

        closeButton.disabled = true;
        strip.classList.add('welcome-strip--dismissed');
        section?.classList.add('welcome-strip-section--dismissed');
        strip.setAttribute('aria-hidden', 'true');
        document.body?.classList.add('welcome-strip-dismissed');
        updateHeaderOffsets();
        window.setTimeout(updateHeaderOffsets, 240);
      });
    })();
  </script>





