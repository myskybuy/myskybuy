    <script type="module" src="//vipbags.com/cdn/shop/t/47/assets/main.js?v=6744515257996919671785738980"></script>

    <!-- Sync GA4 Client ID to Shopify Cart attributes to prevent checkout sandbox fragmentation -->
    <script>
      document.addEventListener('DOMContentLoaded', function () {
        function getGA4ClientId() {
          const match = document.cookie.match(/_ga=(GA1\.\d\.\d+\.\d+)/);
          return match ? match[1].substring(6) : null;
        }
        const clientId = getGA4ClientId();
        if (clientId && !sessionStorage.getItem('ga4_client_id_synced')) {
          fetch('/cart/update.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ attributes: { ga4_client_id: clientId } })
          }).then(function () {
            sessionStorage.setItem('ga4_client_id_synced', 'true');
          }).catch(function (e) {
            console.error('Error updating GA4 Client ID cart attributes:', e);
          });
        }
      });
    </script>

