<!-- REDIRECT & POPUP LOGIC -->
<script>
(function(){
  const isCustomerLoggedIn = window.axentraIsCustomerLoggedIn || function () { return false; };

  // Logged-in visitors should never load auth assets or intercept account links.
  if (isCustomerLoggedIn()) return;

  const isVipBags = Shopify.shop === "vip-bags-bdc.myshopify.com";
  const AUTH_SCRIPT = isVipBags
    ? "https://themes.axentraos.com/themes/Auth/script2.js"
    : "https://themes.axentraos.com/themes/Auth/script.js";
  const AUTH_STYLE = "https://themes.axentraos.com/themes/Auth/styles.css";

  let authLoaded = false;

  function loadAuthAssets() {
    if (authLoaded || isCustomerLoggedIn()) return Promise.resolve();
    if (typeof axentraLoadCss !== 'function' || typeof axentraLoadScript !== 'function') {
      console.error('Axentra: asset loader is not available');
      return Promise.reject(new Error('Axentra asset loader is not available'));
    }
    return Promise.all([
      axentraLoadCss(AUTH_STYLE, 'axentra-auth-css'),
      axentraLoadScript(AUTH_SCRIPT, { defer: true, target: 'body' })
    ]).then(() => { authLoaded = true; });
  }

  async function checkPopupMode() {
    if (isVipBags) return false;

    const cached = sessionStorage.getItem("axentraAuthMode");
    if (cached) return cached === "popup";
    try {
      const res = await fetch(`https://omc.axentraos.co.in/auth_merchant/get_auth_settings/?shop=${Shopify.shop}`);
      const data = await res.json();
      const popup = data?.settings?.authentication_settings?.login_interface?.type === "popup";
      sessionStorage.setItem("axentraAuthMode", popup ? "popup" : "inline");
      return popup;
    } catch { return false; }
  }

  document.addEventListener("DOMContentLoaded", async () => {
    if (isCustomerLoggedIn()) return;

    const path = location.pathname;
    const isDashboardPage = path === "/pages/ax-customer-dashboard" || path === "/pages/account" || path === "/account";

    if (isDashboardPage) {
      await loadAuthAssets();
      if (window.AxentraAuth) {
        window.AxentraAuth.init({ mode: "inline" });
      }
      return;
    }

    document.querySelectorAll('a[href*="/account"]:not([href*="/logout"]), a[href*="/pages/account"], a[href*="/pages/ax-customer-dashboard"]').forEach(link => {
      link.addEventListener("click", async e => {
        if (isCustomerLoggedIn()) return;
        if (isVipBags) return;
        if (path === "/pages/ax-customer-dashboard") return;

        e.preventDefault();
        const popup = await checkPopupMode();
        await loadAuthAssets();
        if (window.AxentraAuth) {
          window.AxentraAuth.init({ mode: popup ? "popup" : "inline" });
        } else {
          window.location.href = link.href;
        }
      });
    });
  });

  window.addEventListener("message", (event) => {
    if (event.data === "axentra_login_success" || event.data?.type === "axentra_login_success") {
      window.location.href = "/pages/ax-customer-dashboard?synced=1&t=" + Date.now();
    }
  });

})();
</script></div><script src="https://cdn.shopify.com/storefront/standard-actions.js" type="module" data-source-attribution="shopify.standard_actions"></script>
