<!-- BEGIN app snippet: axentra-script-loader --><script>
(function () {
  if (window.axentraLoadScript) return;

  const TTL_HOURS = 6;
  const COOKIE_PREFIX = 'axentra_asset_';
  const LS_PREFIX = 'axentra_asset_cache_';

  function normalizeUrl(url) {
    try {
      const u = new URL(url, window.location.origin);
      u.searchParams.delete('v');
      return u.pathname + (u.search || '');
    } catch {
      return url.split('?')[0];
    }
  }

  function assetKey(url) {
    const normalized = normalizeUrl(url);
    let h = 0;
    for (let i = 0; i < normalized.length; i++) {
      h = ((h << 5) - h + normalized.charCodeAt(i)) | 0;
    }
    return Math.abs(h).toString(36);
  }

  function setCookie(name, value) {
    const maxAge = TTL_HOURS * 60 * 60;
    document.cookie = `${name}=${encodeURIComponent(value)}; max-age=${maxAge}; path=/; SameSite=Lax`;
  }

  function getCookie(name) {
    const match = document.cookie.match(
      new RegExp('(?:^|; )' + name.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + '=([^;]*)')
    );
    return match ? decodeURIComponent(match[1]) : null;
  }

  function readCache(url) {
    const key = assetKey(url);
    const cookieName = COOKIE_PREFIX + key;
    const lsKey = LS_PREFIX + key;
    if (getCookie(cookieName)) {
      const cached = localStorage.getItem(lsKey);
      if (cached) return cached;
    }
    return null;
  }

  function writeCache(url, content) {
    const key = assetKey(url);
    try {
      localStorage.setItem(LS_PREFIX + key, content);
      setCookie(COOKIE_PREFIX + key, '1');
    } catch (e) {
      /* storage full or blocked */
    }
  }

  function injectScript(content, opts) {
    const script = document.createElement('script');
    script.textContent = content;
    if (opts && opts.defer) script.defer = true;
    (opts && opts.target === 'body' ? document.body : document.head).appendChild(script);
    return script;
  }

  window.axentraFetchCached = async function (url, fetchOpts) {
    const cached = readCache(url);
    if (cached) return cached;

    const res = await fetch(url, fetchOpts || { cache: 'no-store' });
    if (!res.ok) throw new Error(`Failed to fetch ${url}: ${res.status}`);
    const text = await res.text();
    writeCache(url, text);
    return text;
  };

  window.axentraLoadScript = function (url, opts) {
    opts = opts || {};
    const cached = readCache(url);
    if (cached) {
      injectScript(cached, opts);
      return Promise.resolve();
    }

    return fetch(url)
      .then(function (r) {
        if (!r.ok) throw new Error(`Failed to load script ${url}: ${r.status}`);
        return r.text();
      })
      .then(function (text) {
        writeCache(url, text);
        injectScript(text, opts);
      });
  };

  window.axentraLoadCss = function (url, id) {
    if (id && document.getElementById(id)) return Promise.resolve();

    const cached = readCache(url);
    if (cached) {
      const el = document.createElement('style');
      if (id) el.id = id;
      el.textContent = cached;
      document.head.appendChild(el);
      return Promise.resolve();
    }

    return fetch(url)
      .then(function (r) {
        if (!r.ok) throw new Error(`Failed to load css ${url}: ${r.status}`);
        return r.text();
      })
      .then(function (text) {
        writeCache(url, text);
        const el = document.createElement('style');
        if (id) el.id = id;
        el.textContent = text;
        document.head.appendChild(el);
      });
  };
})();
</script>
