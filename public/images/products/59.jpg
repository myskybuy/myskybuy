<script>
  (function() {
    function ensurePlayHeroVideos() {
      var videos = document.querySelectorAll('.ui-hero-banner video');
      videos.forEach(function(video) {
        video.classList.add('is-loaded');
        video.style.opacity = '1';
        if (video.paused && video.hasAttribute('autoplay')) {
          video.play().catch(function() {});
        }
      });
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', ensurePlayHeroVideos);
    } else {
      ensurePlayHeroVideos();
    }
    document.addEventListener('shopify:section:load', ensurePlayHeroVideos);
    document.addEventListener('shopify:block:select', ensurePlayHeroVideos);
  })();
</script>

