<script>
  (() => {
    const searchModal = document.getElementById('search-modal');
    if (!searchModal) return;
    const headerComponent = document.querySelector('header-component');

    const updateSearchModalOffsets = () => {
      const brandTopbar = document.querySelector('.brand-topbar');
      const header = document.querySelector('header-component');
      let visibleBrandTopbarHeight = 0;
      let searchModalOffsetTop = 0;

      if (brandTopbar instanceof HTMLElement) {
        const brandTopbarRect = brandTopbar.getBoundingClientRect();
        visibleBrandTopbarHeight = Math.max(
          0,
          Math.min(
            brandTopbarRect.bottom,
            brandTopbarRect.height,
            window.innerHeight - Math.max(brandTopbarRect.top, 0)
          )
        );
      }

      if (header instanceof HTMLElement) {
        const headerRect = header.getBoundingClientRect();
        searchModalOffsetTop = Math.max(0, Math.min(headerRect.bottom, window.innerHeight));
      }

      document.body.style.setProperty('--brand-topbar-height', `${visibleBrandTopbarHeight}px`);
      document.body.style.setProperty('--search-modal-dynamic-offset-top', `${searchModalOffsetTop}px`);
    };

    const openClassName = 'search-menu-open';
    const forcedStickyAttribute = 'data-search-forced-sticky-state';

    const forceHeaderStickyActive = () => {
      if (!(headerComponent instanceof HTMLElement)) return;

      if (!headerComponent.hasAttribute(forcedStickyAttribute)) {
        headerComponent.setAttribute(forcedStickyAttribute, headerComponent.dataset.stickyState || '');
      }

      headerComponent.dataset.stickyState = 'active';
    };

    const restoreHeaderStickyState = () => {
      if (!(headerComponent instanceof HTMLElement)) return;

      const previousStickyState = headerComponent.getAttribute(forcedStickyAttribute);
      if (previousStickyState === '') {
        delete headerComponent.dataset.stickyState;
      } else if (previousStickyState != null) {
        headerComponent.dataset.stickyState = previousStickyState;
      }

      headerComponent.removeAttribute(forcedStickyAttribute);
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', updateSearchModalOffsets, { once: true });
    } else {
      updateSearchModalOffsets();
    }

    window.addEventListener('resize', updateSearchModalOffsets);
    window.addEventListener('scroll', updateSearchModalOffsets, { passive: true });
    window.addEventListener('load', updateSearchModalOffsets, { once: true });

    searchModal.addEventListener('dialog:open', () => {
      document.body.classList.add(openClassName);
      forceHeaderStickyActive();
      updateSearchModalOffsets();
      requestAnimationFrame(updateSearchModalOffsets);
    });

    searchModal.addEventListener('dialog:close', () => {
      document.body.classList.remove(openClassName);
      restoreHeaderStickyState();
    });
  })();
</script>


    
