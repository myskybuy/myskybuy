    <script src="//vipbags.com/cdn/shop/t/47/assets/wishlist-omc.js?v=106094947629010687381786521595" defer></script>
    <script>
      if (window.location.pathname === '/collections/vip') {
        window.location.replace('/vip/collections/all');
      }
    </script>
    <script>
      document.addEventListener('DOMContentLoaded', function () {
        function updateVariant(variantId) {
          if (!variantId) return;

          // Update hidden variant input
          document.querySelectorAll('form[action*="/cart/add"] input[name="id"]').forEach((input) => {
            input.value = variantId;
            input.dispatchEvent(new Event('change', { bubbles: true }));
          });

          // Update URL
          const url = new URL(window.location.href);
          url.searchParams.set('variant', variantId);
          window.history.replaceState({}, '', url);

          // Trigger Shopify change event
          document.dispatchEvent(
            new CustomEvent('variant:change', {
              detail: {
                variant: {
                  id: variantId,
                },
              },
            })
          );
        }

        // Color swatches
        document.addEventListener('click', function (e) {
          const swatch =
            e.target.closest('[data-variant-id]') ||
            e.target.closest('[data-swatch]') ||
            e.target.closest('.product-form__input input[type="radio"]');

          if (!swatch) return;

          // Exclude cart edit buttons, quantity selectors, or other cart/edit elements
          if (
            swatch.hasAttribute('data-cart-item-edit') ||
            swatch.tagName.toLowerCase().includes('quantity-selector') ||
            swatch.closest('.cart-items, .cart-drawer, cart-items-component, .cart-item-edit-popup')
          ) {
            return;
          }

          let variantId = swatch.dataset.variantId || swatch.getAttribute('data-variant-id');

          if (!variantId && swatch.value) {
            const optionValue = swatch.value;

            const variantJson = document.querySelector('[type="application/json"][data-product-json]');
            if (variantJson) {
              const product = JSON.parse(variantJson.textContent);

              const variant = product.variants.find(
                (v) => v.option1 === optionValue || v.option2 === optionValue || v.option3 === optionValue
              );

              if (variant) {
                variantId = variant.id;
              }
            }
          }

          if (variantId) {
            updateVariant(variantId);
          }
        });
      });
    </script>
    <script>
      document.addEventListener('click', function (e) {
        const swatch = e.target.closest('[data-variant-id]');

        if (!swatch) return;

        // Exclude cart edit buttons, quantity selectors, or other cart/edit elements
        if (
          swatch.hasAttribute('data-cart-item-edit') ||
          swatch.tagName.toLowerCase().includes('quantity-selector') ||
          swatch.closest('.cart-items, .cart-drawer, cart-items-component, .cart-item-edit-popup')
        ) {
          return;
        }

        const variantId = swatch.dataset.variantId;

        if (!variantId) return;

        const url = new URL(window.location.href);
        url.searchParams.set('variant', variantId);

        window.location.href = url.toString();
      });
    </script>
    <script>
      document.addEventListener('change', function (e) {
        const variantInput = e.target.closest('input[type="radio"]');

        if (!variantInput) return;

        setTimeout(() => {
          const productDataEl = document.querySelector('script[type="application/json"][data-product-json]');

          if (!productDataEl) return;

          const product = JSON.parse(productDataEl.textContent);

          const selectedOptions = [];

          document.querySelectorAll('.product-form__input input:checked').forEach((input) => {
            selectedOptions.push(input.value);
          });

          const currentVariant = product.variants.find((v) => {
            return [v.option1, v.option2, v.option3]
              .filter(Boolean)
              .every((option) => selectedOptions.includes(option));
          });

          if (!currentVariant) return;

          // Update URL
          const url = new URL(window.location.href);
          url.searchParams.set('variant', currentVariant.id);
          history.replaceState({}, '', url);

          // Switch image
          if (currentVariant.featured_media) {
            const mediaId = currentVariant.featured_media.id;

            const targetMedia = document.querySelector(`[data-media-id*="${mediaId}"]`);

            if (targetMedia) {
              targetMedia.scrollIntoView({
                behavior: 'smooth',
                block: 'nearest',
              });

              targetMedia.click?.();
            }
          }
        }, 100);
      });
    </script>
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        hideUnavailableColors();
        initializeLazyVideos();
      });
      document.addEventListener('shopify:section:load', () => {
        hideUnavailableColors();
        initializeLazyVideos();
      });

      function hideUnavailableColors() {
        document.querySelectorAll('facet-filters-form li, .facets__item').forEach((item) => {
          const text = item.textContent.trim();

          // Find count in brackets e.g. Black (0)
          const match = text.match(/\((\d+)\)/);

          if (match && parseInt(match[1], 10) === 0) {
            item.style.display = 'none';
          }
        });
      }

      function initializeLazyVideos() {
        const isMobile = window.innerWidth < 1024;
        const lazyVideos = document.querySelectorAll('video.lazy-video');

        if ('IntersectionObserver' in window) {
          const videoObserver = new IntersectionObserver(
            (entries, observer) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  const video = entry.target;
                  if (!video.querySelector('source')) {
                    const src = isMobile ? video.dataset.mobileSrc : video.dataset.desktopSrc;
                    if (src) {
                      const source = document.createElement('source');
                      source.src = src;
                      source.type = 'video/mp4';
                      video.appendChild(source);
                      video.load();
                      video.addEventListener('loadeddata', function () {
                        video.classList.add('is-loaded');
                        if (video.hasAttribute('autoplay')) {
                          video.play().catch(() => {});
                        }
                      });
                      // Also try playing on canplay in case loadeddata fires late
                      video.addEventListener('canplay', function () {
                        if (video.hasAttribute('autoplay') && video.paused) {
                          video.play().catch(() => {});
                        }
                      }, { once: true });
                    }
                  } else if (video.hasAttribute('autoplay') && video.paused) {
                    video.play().catch(() => {});
                  }
                  observer.unobserve(video);
                }
              });
            },
            {
              rootMargin: '300px',
            }
          );

          lazyVideos.forEach((video) => {
            videoObserver.observe(video);
          });
        } else {
          lazyVideos.forEach((video) => {
            if (video.querySelector('source')) return;
            const src = isMobile ? video.dataset.mobileSrc : video.dataset.desktopSrc;
            if (src) {
              const source = document.createElement('source');
              source.src = src;
              source.type = 'video/mp4';
              video.appendChild(source);
              video.load();
              video.addEventListener('loadeddata', function () {
                video.classList.add('is-loaded');
                if (video.hasAttribute('autoplay')) {
                  video.play().catch(() => {});
                }
              });
            }
          });
        }
      }

      // Global autoplay enforcer: find any autoplay video that is paused and force-play it
      function enforceAutoplay() {
        document.querySelectorAll('video[autoplay]').forEach(function(video) {
          if (video.paused && video.readyState >= 2) {
            video.muted = true;
            video.play().catch(() => {});
          }
        });
      }

      document.addEventListener('DOMContentLoaded', function() {
        enforceAutoplay();
        // Run again after a short delay to catch videos loaded by lazy observers
        setTimeout(enforceAutoplay, 1000);
        setTimeout(enforceAutoplay, 3000);
      });
    </script>
  <div id="shopify-block-AZkZsaUJxb2ZCZTBaO__15578186725327338453" class="shopify-block shopify-app-block">  
  <!-- BEGIN app snippet: axentra-script-loader --><script>
(function () {
  if (window.axentraLoadScript) return;

  const TTL_HOURS = 6;
  const COOKIE_PREFIX = 'axentra_asset_';
  const LS_PREFIX = 'axentra_asset_cache_';

  function normalizeUrl(url) {
    try {
      const u = new URL(url, window.location.origin);
      u.searchParams.delete('v');
      return u.pathname + (u.search || '');
    } catch {
      return url.split('?')[0];
    }
  }

  function assetKey(url) {
    const normalized = normalizeUrl(url);
    let h = 0;
    for (let i = 0; i < normalized.length; i++) {
      h = ((h << 5) - h + normalized.charCodeAt(i)) | 0;
    }
    return Math.abs(h).toString(36);
  }

  function setCookie(name, value) {
    const maxAge = TTL_HOURS * 60 * 60;
    document.cookie = `${name}=${encodeURIComponent(value)}; max-age=${maxAge}; path=/; SameSite=Lax`;
  }

  function getCookie(name) {
    const match = document.cookie.match(
      new RegExp('(?:^|; )' + name.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + '=([^;]*)')
    );
    return match ? decodeURIComponent(match[1]) : null;
  }

  function readCache(url) {
    const key = assetKey(url);
    const cookieName = COOKIE_PREFIX + key;
    const lsKey = LS_PREFIX + key;
    if (getCookie(cookieName)) {
      const cached = localStorage.getItem(lsKey);
      if (cached) return cached;
    }
    return null;
  }

  function writeCache(url, content) {
    const key = assetKey(url);
    try {
      localStorage.setItem(LS_PREFIX + key, content);
      setCookie(COOKIE_PREFIX + key, '1');
    } catch (e) {
      /* storage full or blocked */
    }
  }

  function injectScript(content, opts) {
    const script = document.createElement('script');
    script.textContent = content;
    if (opts && opts.defer) script.defer = true;
    (opts && opts.target === 'body' ? document.body : document.head).appendChild(script);
    return script;
  }

  window.axentraFetchCached = async function (url, fetchOpts) {
    const cached = readCache(url);
    if (cached) return cached;

    const res = await fetch(url, fetchOpts || { cache: 'no-store' });
    if (!res.ok) throw new Error(`Failed to fetch ${url}: ${res.status}`);
    const text = await res.text();
    writeCache(url, text);
    return text;
  };

  window.axentraLoadScript = function (url, opts) {
    opts = opts || {};
    const cached = readCache(url);
    if (cached) {
      injectScript(cached, opts);
      return Promise.resolve();
    }

    return fetch(url)
      .then(function (r) {
        if (!r.ok) throw new Error(`Failed to load script ${url}: ${r.status}`);
        return r.text();
      })
      .then(function (text) {
        writeCache(url, text);
        injectScript(text, opts);
      });
  };

  window.axentraLoadCss = function (url, id) {
    if (id && document.getElementById(id)) return Promise.resolve();

    const cached = readCache(url);
    if (cached) {
      const el = document.createElement('style');
      if (id) el.id = id;
      el.textContent = cached;
      document.head.appendChild(el);
      return Promise.resolve();
    }

    return fetch(url)
      .then(function (r) {
        if (!r.ok) throw new Error(`Failed to load css ${url}: ${r.status}`);
        return r.text();
      })
      .then(function (text) {
        writeCache(url, text);
        const el = document.createElement('style');
        if (id) el.id = id;
        el.textContent = text;
        document.head.appendChild(el);
      });
  };
})();
</script>
